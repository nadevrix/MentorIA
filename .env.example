# === Requerido ===
# Clave de la API de Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# === Backend (apps/api) ===
PORT=8787
# Origenes permitidos por CORS, separados por coma. "*" en desarrollo.
CORS_ORIGIN=*
# Fuente de datos: "seed" (JSON local) | "supabase" (pendiente, Persona 2)
DATA_SOURCE=seed

# === Tipo de cambio (Agente Cambiario) ===
# Fuente del dolar paralelo: "static" (usa data/seed/fx.json) | "firecrawl"
FX_SOURCE=static
FIRECRAWL_API_KEY=

# === Frontend (apps/web) ===
# URL del backend desplegado en Render. En local: http://localhost:8787
VITE_API_URL=http://localhost:8787
