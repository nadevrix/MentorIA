# === Motor de agentes ===
# Proveedor del modelo: "gemini" (por defecto) | "anthropic"
# Si el elegido no tiene su clave configurada, el sistema cae al otro en vez de romper.
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Modelo a usar. Medido sobre el loop de agentes de este proyecto:
#   gemini-3.1-flash-lite   4,2 s y cadena completa de herramientas  <- por defecto
#   gemini-2.5-flash        13 s, misma cadena
#   cualquier "pro"         sin cuota en el free tier
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Claude, como respaldo (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# === Backend (apps/api) ===
PORT=8787
# Orígenes permitidos por CORS, separados por coma y sin barra final.
# Usar "*" sólo en local o durante el primer despliegue.
CORS_ORIGIN=*

# Protección básica de los endpoints que consumen IA. El límite es por IP y ruta.
AI_RATE_LIMIT_MAX=6
AI_RATE_LIMIT_WINDOW_MS=60000
# Límites de cuerpo HTTP: 128 KiB para JSON y 2 MiB para CSV.
MAX_JSON_BODY_BYTES=131072
MAX_CSV_BODY_BYTES=2097152

# === Datos ===
# Fuente: "seed" (JSON local, solo desarrollo) | "postgres" (Render/Neon/etc.)
# En producción (render.yaml) va postgres con base vacía de negocio.
DATA_SOURCE=seed
# Cadena de conexión. Obligatoria si DATA_SOURCE=postgres.
DATABASE_URL=
# Esquema + FX de mercado (negocio vacío): npm run db:migrate
# Cargar demo comercial opcional:       npm run db:seed
# Vaciar tablas del negocio:            npm run db:reset

# Fecha fija opcional para una demo reproducible (AAAA-MM-DD).
DEMO_TODAY=

# Rutas opcionales para reemplazar los catálogos versionados:
# SEED_DIR=/ruta/absoluta/a/seed
# TAX_FORMS_FILE=/ruta/absoluta/a/formularios.json
# FORMALIZACION_FILE=/ruta/absoluta/a/formalizacion.json

# === Tipo de cambio (Agente Cambiario) ===
# "static" usa data/seed/fx.json.
# "dolar-blue-bolivia" consulta la tasa oficial unificada publicada por la API
# pública de Dólar Blue Bolivia. "firecrawl" mantiene la integración del reto.
# Ambos proveedores en vivo caen al histórico local si la consulta falla.
FX_SOURCE=static
FIRECRAWL_API_KEY=

# === Frontend (apps/web) ===
# URL del backend. Vite la inserta durante el build; cambiarla exige redesplegar.
VITE_API_URL=http://localhost:8787

# === Generación de imágenes para marketing (opcional, sólo backend) ===
# Anthropic no genera imágenes: Claude escribe el prompt y otro proveedor lo
# convierte en píxeles. Sin esto, la app muestra el prompt para copiar.
IMAGE_PROVIDER=openai      # openai | gemini
IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024
