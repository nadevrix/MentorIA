# === Motor de agentes ===
# Proveedor del modelo: "gemini" (por defecto) | "anthropic"
# Si el elegido no tiene su clave configurada, el sistema cae al otro en vez de romper.
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Modelo a usar. Más capaz -> más caro y más lento.
#   gemini-2.5-flash-lite   el más barato
#   gemini-2.5-flash        equilibrio recomendado para el loop de agentes
#   gemini-2.5-pro          el más capaz
GEMINI_MODEL=gemini-2.5-flash

# --- Claude, como respaldo (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium

# === Backend (apps/api) ===
PORT=8787
# Origenes permitidos por CORS, separados por coma. "*" en desarrollo.
CORS_ORIGIN=*
# Fuente de datos: "seed" (JSON local) | "postgres" (Neon / Render / Supabase)
DATA_SOURCE=seed
# Cadena de conexión de Postgres. Sirve igual para Neon, Render o Supabase.
DATABASE_URL=

# === Tipo de cambio (Agente Cambiario) ===
# Fuente del dolar paralelo: "static" (usa data/seed/fx.json) | "firecrawl"
FX_SOURCE=static
FIRECRAWL_API_KEY=

# === Frontend (apps/web) ===
# URL del backend desplegado en Render. En local: http://localhost:8787
VITE_API_URL=http://localhost:8787

# Generación de imágenes para marketing (opcional).
# Anthropic no genera imágenes: Claude escribe el prompt y otro proveedor lo
# convierte en píxeles. Sin esto, la app muestra el prompt para copiar.
IMAGE_PROVIDER=openai      # openai | gemini
IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024

# Base de datos. Sin esto se usan los JSON de data/seed/.
#   DATA_SOURCE=postgres  +  DATABASE_URL  ->  Postgres (Neon)
#   sin DATA_SOURCE                        ->  datos semilla
# Cargar el esquema y los datos:  npm run db:migrate   (o db:reset para recargar)
DATA_SOURCE=
DATABASE_URL=
